# Copy to `.env` (loaded automatically on Node >= 20.12) or export in your shell.
# Every value has these defaults, so the demo runs with no .env at all.

# Postgres (psql-compatible names — `npm run init-db` picks them up too)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# HTTP edge (server)
PORT=8000
API_TOKEN=secret            # demo default — change for anything real

# Broker log / consumer
ETL_LOG_DIR=.               # where server_events_*.jsonl partitions and the dead-letter file live
POLL_INTERVAL_MS=5000       # processor poll cadence
DEAD_LETTER_FILE=dead_letter.jsonl

# Producer (client)
SERVER_URL=http://localhost:8000
EVENTS_FILE=events.jsonl
